{
  "name": "@ccgrapher/runner-managed-agents",
  "version": "0.5.0",
  "type": "module",
  "description": "Runs each model step of a workflow graph as its own Claude Managed Agents session, so the ccgrapher runner keeps the order, the guards and the trace.",
  "keywords": [
    "agent",
    "workflow",
    "graph",
    "dag",
    "orchestration",
    "lint",
    "diagram",
    "llm"
  ],
  "license": "Apache-2.0",
  "author": "artfusion",
  "homepage": "https://github.com/artfusion/ccgrapher#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artfusion/ccgrapher.git",
    "directory": "packages/runner-managed-agents"
  },
  "bugs": {
    "url": "https://github.com/artfusion/ccgrapher/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@ccgrapher/codegen": "workspace:*",
    "@ccgrapher/core": "workspace:*",
    "@ccgrapher/runner": "workspace:*"
  },
  "devDependencies": {
    "@ccgrapher/lint": "workspace:*",
    "@ccgrapher/trace": "workspace:*"
  }
}
