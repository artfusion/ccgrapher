{
  "name": "@ccgrapher/ingest",
  "version": "0.2.0",
  "type": "module",
  "description": "Reconstructs a workflow spec from existing TypeScript orchestration code.",
  "keywords": [
    "agent",
    "workflow",
    "graph",
    "dag",
    "orchestration",
    "lint",
    "diagram",
    "llm"
  ],
  "license": "Apache-2.0",
  "author": "artfusion",
  "homepage": "https://github.com/artfusion/ccgrapher#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artfusion/ccgrapher.git",
    "directory": "packages/ingest"
  },
  "bugs": {
    "url": "https://github.com/artfusion/ccgrapher/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@ccgrapher/core": "workspace:*",
    "ts-morph": "^24.0.0"
  },
  "devDependencies": {
    "@ccgrapher/codegen": "workspace:*"
  }
}
