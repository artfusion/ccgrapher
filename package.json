{
  "name": "ccgrapher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turn an agent-workflow spec into a layered hand-drawn graph, lint it for wasted sequencing, and generate the orchestration code.",
  "keywords": [
    "agent",
    "workflow",
    "graph",
    "dag",
    "orchestration",
    "lint",
    "diagram",
    "llm"
  ],
  "license": "Apache-2.0",
  "author": "artfusion",
  "homepage": "https://github.com/artfusion/ccgrapher#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artfusion/ccgrapher.git"
  },
  "bugs": {
    "url": "https://github.com/artfusion/ccgrapher/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && rm -rf packages/*/dist apps/*/dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit false --pretty",
    "ccg": "node --experimental-strip-types apps/cli/src/index.ts"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "jsdom": "^25.0.1",
    "mermaid": "^11.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wawoff2": "^2.0.1"
  }
}
